{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>chodeus/chodeus-ops"
  ],
  "baseBranches": [
    "main",
    "develop"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "allowedVersions": "<10",
      "description": "ESLint v10 is not compatible with the current frontend lint setup. Keep ESLint packages on v9 until the config is migrated."
    }
  ]
}
