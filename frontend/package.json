{
  "name": "chub-media-manager",
  "version": "1.0.0",
  "description": "CHUB — Chodeus' Media Script Hub (React 19 frontend)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src --ext .js,.jsx && node scripts/check-field-types.js",
    "check:schema": "node scripts/check-field-types.js",
    "check:classes": "node scripts/check-tailwind-classes.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "stylelint": "stylelint 'src/**/*.css' --fix"
  },
  "dependencies": {
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.26",
    "cron-validator": "^1.4.0",
    "cronstrue": "^3.38.0",
    "prop-types": "15.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
